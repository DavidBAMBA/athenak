# AthenaK input file for the 3D Kruskal-Schwarzschild Instability
#
# Same physics and equilibrium as athinput.2dksi, extended to three dimensions.
# The current sheet lies in the x1-x3 plane at x2 = 0; gravity is along -x2 and the
# reflecting walls stay on x2, exactly as in 2D.  x1 and x3 are both periodic.
#
# Equilibrium (function of x2 only, identical to the 2D case):
#   B3 = -b0*tanh(x2/a),  rho = 1 + 2*sech^2(x2/a),  p = p0*sech^2(x2/a)
#   b0 = sqrt(sigma), p0 = b0^2/2, so p_gas + B^2/2 = p0 exactly.
#
# NOTE ON HYDROSTATIC BALANCE: there is no exactly balanced initial state for these
# profiles -- integrating d(p_gas+B^2/2)/dx2 = -w*g downward drives p_gas negative at
# x2 = -0.0168.  Gill+2018 drop the stratification (their eqs. 8-10) since Delta << c^2/g.
# The residual O(2-4%) imbalance settles against the walls on t_A ~ 0.21; the hydrostatic
# pressure correction in the user BC keeps that from launching acoustic waves.
#
# Reference: Gill, Granot & Lyubarsky 2018, MNRAS 474, 3535

<comment>
problem   = 3D Kruskal-Schwarzschild instability in special relativistic MHD
reference = Gill, Granot & Lyubarsky 2018, MNRAS 474, 3535
configure = -D PROBLEM=ksi

<job>
basename  = ksi3d

<mesh>
nghost    = 4              # ppmx needs 4

nx1       = 224            # transverse to the sheet normal (periodic)
x1min     = -0.05
x1max     =  0.05
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 448            # sheet normal / gravity direction (reflecting walls)
x2min     = -0.1
x2max     =  0.1
ix2_bc    = user           # reflecting + hydrostatic pressure correction
ox2_bc    = user

nx3       = 224            # second transverse direction (periodic), B is along x3
x3min     = -0.05
x3max     =  0.05
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 56             # 224/56 = 4
nx2       = 56             # 448/56 = 8
nx3       = 56             # 224/56 = 4  -> 128 MeshBlocks

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3           # MUST be <= 1/3 in 3D. AthenaK sets dt = cfl*min_i(dx_i/c_i),
                           #   so for an unsplit scheme the actual Courant number is the
                           #   SUM over directions, ~cfl*ndim. The stability limit is 1,
                           #   hence cfl <= 1/2 in 2D and cfl <= 1/3 in 3D.
                           #   Verified empirically at 96x192x48 (isotropic cells):
                           #     cfl=0.4 -> sum 1.2 -> NaN at t~0.03
                           #     cfl=0.3 -> sum 0.9 -> clean
                           #   A run with dx3 = 2*dx1 survives cfl=0.4 only because the
                           #   sum is then 0.4*2.5 = 1.0, i.e. exactly marginal. Do not
                           #   rely on that. (The 2D input uses cfl=0.5 => sum 1.0, also
                           #   marginal but long-validated against Athena-C.)
nlim       = -1
tlim       = 20.0
ndiag      = 1

<coord>
special_rel = true

<mhd>
eos         = ideal
reconstruct = ppmx         # matches Athena-C --with-order=3p (Colella-Sekora)
rsolver     = hlle         # NOT hlld in 3D.  In 3D the x3 sweep solves Riemann problems
                           #   with a STRONG NORMAL field (bx = B3 ~ 3.2) through
                           #   near-pressureless gas (p ~ 1e-16, beta ~ 2e-17) -- a
                           #   channel that never arises in 2D, where B3 is always
                           #   transverse.  There the MUB pressure iteration is
                           #   ill-conditioned and pumps growing noise into the
                           #   background.  Controlled comparison, identical grid
                           #   (96x192x48 isotropic), cfl=0.3, iprob=1:
                           #        t      HLLE std      HLLD std
                           #      0.25     3.6e-4        1.2e-1
                           #      0.50     9.6e-4        4.4e-1   (rho reaches 6.7)
                           #   This is NOT the cfl problem above -- both runs used the
                           #   safe cfl=0.3.  HLLD remains the correct choice in 2D,
                           #   where it is validated bit-for-bit on the MUB shock tubes.
gamma       = 1.333333333333
dfloor      = 1.0e-10
pfloor      = 1.0e-18      # must stay below p0*sech^2(x2max/a) = 8.66e-17
fofc        = true

<problem>
user_srcs = true
grav      = -0.1
grav_on_enthalpy = false   # false = f = D*g (Athena-C convention); true = f = w*g (paper)
amp       = 9.5346e-7      # kappa_v * v_A = 1e-6 * sqrt(10/11)
sigma     = 10.0
delta     = 0.01           # FULL fluid-frame width of the hot layer
a         = 0.005          # tanh scale length = delta/2 (do NOT omit)
iprob     = 1              # 1 = single mode (Gill+2018 eq. 15), the 3D analogue of the
                           #   2D production run and what makes the two comparable.
                           # 2 = multimode white noise, physically the better seed for
                           #   3D, BUT per-cell noise puts almost no power on box-scale
                           #   modes (coherent amplitude ~ amp/sqrt(N_cells)), so with
                           #   the Gill amplitude 9.5e-7 it stays 6 orders below the
                           #   iprob=1 run at t=4 and never reaches the nonlinear phase
                           #   within tlim=20.  If you want iprob=2, raise amp to ~1e-4.
nx        = 1              # mode numbers, used by iprob=1 only
ny        = 1
nz        = 1

<output1>
file_type = hst
dt        = 0.01

<output2>
file_type = bin            # 3D volume data; VTK would be far larger
variable  = mhd_w
dt        = 0.25

<output3>
file_type = bin
variable  = mhd_bcc
dt        = 0.25

<output4>
file_type = rst
dt        = 1.0
